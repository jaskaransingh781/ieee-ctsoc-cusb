# Copy this file to ".env" and fill it in. The real .env is ignored by git
# and must never be committed or shared.

# The Gmail account that sends the contact-form emails.
GMAIL_USER=ieeectsoc.cu@gmail.com

# A Gmail "App password" for that account (16 characters, no spaces).
# This is NOT the normal Gmail password. Create one at
# https://myaccount.google.com/apppasswords (2-Step Verification must be on).
GMAIL_APP_PASSWORD=

# Where queries are delivered. Leave as the chapter inbox.
CONTACT_TO=ieeectsoc.cu@gmail.com

# Port for the Node server (the Vite dev server proxies /api to it).
PORT=8787

# Only set this if the website and this server are on different domains,
# e.g. https://your-site.example
ALLOWED_ORIGIN=
